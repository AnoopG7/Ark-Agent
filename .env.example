# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL (docker compose service "db")
POSTGRES_USER=ark
POSTGRES_PASSWORD=ark
POSTGRES_DB=ark
DATABASE_URL=postgresql+psycopg://ark:ark@localhost:5432/ark

# Agent
MAX_STEPS=8
RAG_TOP_K=3
RAG_MIN_SCORE=0.60
